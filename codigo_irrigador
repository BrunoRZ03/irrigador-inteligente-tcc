#pragma once
#define BLYNK_AUTH_TOKEN "SEU_TOKEN"
#define WIFI_SSID_SECRET "SUA_REDE"
#define WIFI_PASS_SECRET "SUA_SENHA"

// =====================================================
// Irrigador Inteligente TCC - ESP32 + Blynk + PID
// =====================================================
#define BLYNK_TEMPLATE_ID "SEU_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "Irrigador"
#include <WiFi.h>
#include <BlynkSimpleEsp32.h>
#include "DHT.h"
#include <PID_v1.h>

// ---------------- Sensores ----------------
#define DHTPIN 4
#define DHTTYPE DHT22
DHT dht(DHTPIN, DHTTYPE);

const int pinoHW390 = 34;
const int VALOR_SECO = 2500;
const int VALOR_MOLHADO = 1100;

// ---------------- Bomba (ponte H) ----------------
#define IN3 26
#define IN4 27
#define ENB 25

const int FREQUENCIA_PWM = 1000;
const int RESOLUCAO_PWM = 8;
const int PWM_MAXIMO = 255;

// PWM mínimo para a bomba realmente girar. CALIBRE NA SUA BOMBA:
// aumente o PWM manualmente até ela partir e use esse valor (ou um pouco mais).
const int PWM_MINIMO = 105;

// ---------------- PID ----------------
double Kp = 3.0;
double Ki = 0.3;
double Kd = 1.0;

double umidadeSolo = 0;
double saidaPID = 0;
double setpoint = 75.0;

PID pid(&umidadeSolo, &saidaPID, &setpoint, Kp, Ki, Kd, DIRECT);

// Histerese: o PID só volta a atuar quando o solo cair abaixo de (setpoint - HISTERESE).
// Ele desliga ao atingir o setpoint e zera o integrador (anti-windup).
const double HISTERESE = 1.0;
bool pidAtivo = false;

// ---------------- Temporização (sem delay) ----------------
const unsigned long INTERVALO_AMOSTRA_SOLO = 20;   // 1 leitura analógica a cada 20 ms
const int NUM_AMOSTRAS = 10;                       // média de 10 leituras
const unsigned long INTERVALO_DHT = 2000;          // DHT22 não lê mais rápido que 2 s
const unsigned long INTERVALO_SERIAL = 2000;
const unsigned long INTERVALO_SOLO = 180000;       // envio ao Blynk: 3 min
const unsigned long INTERVALO_CLIMA = 600000;      // envio ao Blynk: 10 min

// Inicializados para que o primeiro envio aconteça logo após conectar
unsigned long ultimoEnvioSolo = 0 - INTERVALO_SOLO;
unsigned long ultimoEnvioClima = 0 - INTERVALO_CLIMA;
unsigned long ultimaLeituraDHT = 0;
unsigned long ultimoSerial = 0;

// ---------------- Estado ----------------
bool soloPronto = false;
float umidadeAr = NAN;
float tempC = NAN;
int pwmAtual = 0;

// =====================================================
// BLYNK
// =====================================================

// Ao (re)conectar, busca no servidor os valores configurados no app
BLYNK_CONNECTED() {
  Blynk.syncVirtual(V3, V4, V5, V6);
}

BLYNK_WRITE(V3) {
  setpoint = constrain(param.asDouble(), 0.0, 100.0);
  Serial.print("Nova umidade desejada: ");
  Serial.println(setpoint, 1);
}

BLYNK_WRITE(V4) {
  Kp = max(0.0, param.asDouble());
  pid.SetTunings(Kp, Ki, Kd);
  Serial.print("Novo Kp: ");
  Serial.println(Kp, 2);
}

BLYNK_WRITE(V5) {
  Ki = max(0.0, param.asDouble());
  pid.SetTunings(Kp, Ki, Kd);
  Serial.print("Novo Ki: ");
  Serial.println(Ki, 2);
}

BLYNK_WRITE(V6) {
  Kd = max(0.0, param.asDouble());
  pid.SetTunings(Kp, Ki, Kd);
  Serial.print("Novo Kd: ");
  Serial.println(Kd, 2);
}

// =====================================================
// BOMBA
// =====================================================

void controlarBomba(int velocidadePWM) {
  if (velocidadePWM <= 0) {
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);
    ledcWrite(ENB, 0);
  } else {
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
    ledcWrite(ENB, velocidadePWM);
  }
}

// Converte a saída do PID (0-255) em PWM útil: 0 desliga;
// qualquer valor acima disso é remapeado para PWM_MINIMO..PWM_MAXIMO
int calcularPWM(double saida) {
  if (saida < 1.0) return 0;
  double s = constrain(saida, 1.0, (double)PWM_MAXIMO);
  return (int)(PWM_MINIMO + (s - 1.0) * (PWM_MAXIMO - PWM_MINIMO) / (PWM_MAXIMO - 1.0));
}

// =====================================================
// LEITURAS (não bloqueantes)
// =====================================================

void lerSolo() {
  static unsigned long ultimaAmostra = 0;
  static long soma = 0;
  static int n = 0;

  if (millis() - ultimaAmostra < INTERVALO_AMOSTRA_SOLO) return;
  ultimaAmostra = millis();

  soma += analogRead(pinoHW390);
  n++;

  if (n >= NUM_AMOSTRAS) {
    int valorSolo = soma / NUM_AMOSTRAS;
    soma = 0;
    n = 0;

    umidadeSolo = ((float)VALOR_SECO - valorSolo) /
                  ((float)VALOR_SECO - VALOR_MOLHADO) * 100.0;
    umidadeSolo = constrain(umidadeSolo, 0.0, 100.0);
    soloPronto = true;
  }
}

void lerDHT() {
  if (millis() - ultimaLeituraDHT < INTERVALO_DHT) return;
  ultimaLeituraDHT = millis();

  umidadeAr = dht.readHumidity();
  tempC = dht.readTemperature();
}

// =====================================================
// CONTROLE
// =====================================================

void controlarIrrigacao() {
  if (!soloPronto) return;  // espera a primeira média do sensor

  if (pidAtivo) {
    if (umidadeSolo >= setpoint) {
      // Atingiu o alvo: desliga e reinicia o PID (zera o termo integral)
      pid.SetMode(MANUAL);
      pidAtivo = false;
      saidaPID = 0;
    }
  } else {
    if (umidadeSolo < setpoint - HISTERESE) {
      saidaPID = 0;                 // o PID_v1 inicializa o integrador com a saída atual
      pid.SetMode(AUTOMATIC);
      pidAtivo = true;
    }
  }

  if (pidAtivo) {
    pid.Compute();  // só calcula de fato a cada SetSampleTime()
  } else {
    saidaPID = 0;
  }

  pwmAtual = calcularPWM(saidaPID);
  controlarBomba(pwmAtual);
}

// =====================================================
// ENVIO AO BLYNK E SERIAL
// =====================================================

void enviarBlynk() {
  if (!Blynk.connected() || !soloPronto) return;

  float erro = setpoint - umidadeSolo;
  float velocidadeBomba = (pwmAtual / 255.0) * 100.0;
  bool bombaLigada = pwmAtual > 0;

  if (millis() - ultimoEnvioSolo >= INTERVALO_SOLO) {
    ultimoEnvioSolo = millis();
    Blynk.virtualWrite(V0, umidadeSolo);
    Blynk.virtualWrite(V7, erro);
    Blynk.virtualWrite(V8, velocidadeBomba);
    Blynk.virtualWrite(V9, bombaLigada);
    Serial.println("Dados do solo e bomba enviados ao Blynk.");
  }

  if (millis() - ultimoEnvioClima >= INTERVALO_CLIMA) {
    ultimoEnvioClima = millis();
    if (!isnan(tempC)) Blynk.virtualWrite(V1, tempC);
    if (!isnan(umidadeAr)) Blynk.virtualWrite(V2, umidadeAr);
    Serial.println("Dados climaticos enviados ao Blynk.");
  }
}

void imprimirSerial() {
  if (millis() - ultimoSerial < INTERVALO_SERIAL) return;
  ultimoSerial = millis();

  float erro = setpoint - umidadeSolo;
  float velocidadeBomba = (pwmAtual / 255.0) * 100.0;

  Serial.print("Temperatura Ar: ");
  if (isnan(tempC)) Serial.print("ERRO");
  else { Serial.print(tempC, 1); Serial.print(" °C"); }

  Serial.print(" | Umidade Ar: ");
  if (isnan(umidadeAr)) Serial.print("ERRO");
  else { Serial.print(umidadeAr, 1); Serial.print("%"); }

  Serial.print(" | Umidade Solo: ");
  Serial.print(umidadeSolo, 1);
  Serial.print("%");

  Serial.print(" | Desejada: ");
  Serial.print(setpoint, 1);
  Serial.print("%");

  Serial.print(" | Erro: ");
  Serial.print(erro, 1);
  Serial.print("%");

  Serial.print(" | Bomba: ");
  Serial.print(velocidadeBomba, 1);
  Serial.println("%");

  Serial.println("-----------------------------");
}

// =====================================================
// SETUP / LOOP
// =====================================================

void setup() {
  Serial.begin(115200);

  pinMode(pinoHW390, INPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENB, OUTPUT);

  ledcAttach(ENB, FREQUENCIA_PWM, RESOLUCAO_PWM);
  controlarBomba(0);

  dht.begin();

  pid.SetOutputLimits(0, 255);
  pid.SetSampleTime(2000);
  pid.SetMode(MANUAL);  // o controle ativa o PID quando o solo estiver seco

  Serial.println();
  Serial.println("--------------------------------");
  Serial.println("Irrigador Inteligente TCC");
  Serial.println("--------------------------------");
  Serial.println("Controle PID ativado");
  Serial.println();

  // Conexão não bloqueante: sem Wi-Fi/Blynk o controle local continua funcionando
  WiFi.begin(WIFI_SSID_SECRET, WIFI_PASS_SECRET);
  Blynk.config(BLYNK_AUTH_TOKEN);
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    Blynk.run();
  }

  lerSolo();
  lerDHT();
  controlarIrrigacao();
  enviarBlynk();
  imprimirSerial();
}
